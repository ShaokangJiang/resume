{%- comment -%} One experience or project entry, matching the markup js/academic-site.js renders. {%- endcomment -%}
<article class="resume-entry{% if include.class %} {{ include.class }}{% endif %}"{% if include.type %} data-type="{{ include.type | escape }}"{% endif %}><div class="entry-heading"><h3>{{ include.title | escape }}</h3><span class="entry-date">{{ include.date | escape }}</span></div><p class="entry-subtitle">{{ include.subtitle | escape }}</p><ul class="entry-details">{% for detail in include.details %}<li>{{ detail | escape }}</li>{% endfor %}</ul>{% if include.links.size > 0 %}<div class="entry-links">{% for item in include.links %}{% include academic-link.liquid item=item %}{% endfor %}</div>{% endif %}</article>
